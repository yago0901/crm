    match /projects/{projectId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('projects')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['planejamento', 'em_andamento', 'concluido', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('projects')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
