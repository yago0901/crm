rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level == 'Admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['lead', 'cliente', 'inativo'];

      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
      );

      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);

      match /interactions/{interactionId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0;

        allow update: if false;

        allow delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
      }
    }

    match /contracts/{contractId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.contactId is string
        && request.resource.data.status in ['rascunho', 'ativo', 'encerrado', 'cancelado'];

      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
      );

      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /employees/{employeeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'ferias', 'desligado'];

      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
      );

      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /payables/{payableId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['pendente', 'pago', 'atrasado'];

      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
      );

      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /receivables/{receivableId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['pendente', 'pago', 'atrasado'];

      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
      );

      allow delete: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
