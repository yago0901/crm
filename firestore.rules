rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Manager is Admin-equivalent for data access, for now (2026-08-28) —
    // both can manage employee logins/module access. Only the two roles
    // that actually need elevated access check this; a future pass may
    // split them further.
    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level in ['Admin', 'Manager'];
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // NOTE: users/{uid} does not have a companyId field yet — that lands in
    // the Fase 0 passo 2 migration. Until then this always evaluates false,
    // which is safe (it just means nobody matches it yet).
    function belongsToCompany(companyId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', null) == companyId;
    }

    // Per-module access, 2026-08-28: Admin/Manager always pass (same as
    // isAdmin() elsewhere -- they see and manage everything). A plain User
    // needs the module key present in their own modules[] grant. This only
    // gates writes and each module's own collections -- reads stay company-
    // scoped only (via belongsToCompany above), on purpose, so the read-only
    // Home dashboard can keep showing the same aggregate numbers to every
    // user regardless of which modules they've been granted (confirmed with
    // the user: a per-module-customized Home was rejected, since someone
    // with more than one granted module wouldn't have a single obvious
    // "preferred" home to land on).
    function hasModule(moduleKey) {
      return isAdmin()
        || (isSignedIn()
          && moduleKey in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('modules', []));
    }

    match /platformAdmins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /companies/{companyId} {
      // get (fetch by exact id) stays open even signed out -- the
      // signup form needs to check "is this slug already taken?"
      // before any account exists yet. list stays restricted so
      // nobody can enumerate every company.
      allow get: if true;
      allow list: if isSuperAdmin() || belongsToCompany(companyId);

      allow create: if isSignedIn()
        && request.resource.data.primaryUserId == request.auth.uid
        && request.resource.data.slug == companyId
        && request.resource.data.plan == 'trial'
        && request.resource.data.maxUsers is int
        && request.resource.data.maxUsers <= 5
        && request.resource.data.userCount == 1
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isSuperAdmin() || (belongsToCompany(companyId) && isAdmin());

      allow delete: if isSuperAdmin();
    }

    match /users/{uid} {
      // An Admin/Manager can read any profile in their own company (needed
      // to list employees' current module grants in "Acessos"), not just
      // their own.
      allow read: if isOwner(uid)
        || (isAdmin() && belongsToCompany(resource.data.get('companyId', null)));

      // Two ways a users/{uid} doc can be created:
      // Path A — self-service signup (Fase 1 passo 1a): a brand-new user
      // may create their own profile only as the Admin of a company where
      // they are already registered as primaryUserId (that company doc is
      // written moments earlier, in the same provisioning flow).
      // Path B — employee login provisioning (Fase 1 passo 9, 2026-08-28):
      // an Admin/Manager creates a profile for one of their own employees.
      // Always forced to level 'User' here — this path can never create
      // another Admin/Manager, closing off privilege escalation. Note this
      // write happens through the *primary* app as the calling Admin/
      // Manager (request.auth.uid is their own uid, not the new employee's)
      // — the new Firebase Auth account itself is created separately via a
      // secondary app instance so the caller's own session is undisturbed.
      allow create: if
        (isOwner(uid)
          && request.resource.data.level == 'Admin'
          && request.resource.data.companyId is string
          && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.primaryUserId == uid)
        || (isAdmin()
          && belongsToCompany(request.resource.data.companyId)
          && request.resource.data.level == 'User');

      // Same split for update: a person editing their own profile (e.g.
      // clearing mustChangePassword) can't change their own level/company;
      // an Admin/Manager editing someone else's profile (granting/revoking
      // modules) can't change that person's level/company/employeeId link
      // either — only modules is meant to move through this path.
      allow update: if
        (isOwner(uid)
          && request.resource.data.level == resource.data.level
          && request.resource.data.companyId == resource.data.get('companyId', null))
        || (isAdmin()
          && belongsToCompany(resource.data.get('companyId', null))
          && request.resource.data.companyId == resource.data.get('companyId', null)
          && request.resource.data.level == resource.data.level
          && request.resource.data.employeeId == resource.data.get('employeeId', null));

      allow delete: if false;
    }

    match /logins/{loginId} {
      allow get: if true;
      allow list: if false;

      // A person can always create their own login mapping (self-service
      // signup). An Admin/Manager can also create one for an employee --
      // not narrowed to their own company's slug prefix, since that would
      // need parsing loginId as a string (tried loginId.split('.')[0],
      // which silently mismatched -- Firestore Rules' split() appears to
      // treat '.' as regex "any character" rather than a literal dot,
      // splitting on every character instead of at the separator). Not
      // narrowing it here is an acceptable trade: this collection only
      // ever powers a get-by-exact-id email lookup (list is false, so it
      // can't be enumerated), and the users/{uid} create rule already
      // strictly enforces the real access boundary -- an Admin/Manager can
      // only ever provision a profile scoped to their own company there,
      // regardless of what login ids this rule alone would allow.
      allow create: if isSignedIn()
        && (request.resource.data.email == request.auth.token.email || isAdmin());

      allow update, delete: if false;
    }

    match /contacts/{contactId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('sales')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['lead', 'cliente', 'inativo'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);

      match /interactions/{interactionId} {
        function parentCompanyId() {
          return get(/databases/$(database)/documents/contacts/$(contactId)).data.get('companyId', null);
        }

        allow read: if belongsToCompany(parentCompanyId());

        allow create: if belongsToCompany(parentCompanyId())
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0;

        allow update: if false;

        allow delete: if belongsToCompany(parentCompanyId())
          && (isAdmin() || resource.data.createdBy == request.auth.uid);
      }
    }

    match /contracts/{contractId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('sales')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.contactId is string
        && request.resource.data.status in ['rascunho', 'ativo', 'encerrado', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /employees/{employeeId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('human-resources')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'ferias', 'desligado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /payables/{payableId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('financial')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['pendente', 'pago', 'atrasado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /receivables/{receivableId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('financial')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['pendente', 'pago', 'atrasado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /followUps/{followUpId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('sales')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['pendente', 'concluido', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('sales')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /ledgerEntries/{entryId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('financial')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.type in ['debito', 'credito'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('financial')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /payrollEntries/{entryId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('human-resources')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() > 0
        && request.resource.data.status in ['pendente', 'pago'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /candidates/{candidateId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('human-resources')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['triagem', 'entrevista', 'aprovado', 'reprovado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /trainings/{trainingId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('human-resources')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.status in ['planejado', 'em_andamento', 'concluido', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /performanceReviews/{reviewId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('human-resources')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() > 0
        && request.resource.data.status in ['rascunho', 'finalizada'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('human-resources')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /suppliers/{supplierId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('inventory-logistics')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'inativo'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /inventoryItems/{itemId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('inventory-logistics')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'descontinuado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /purchaseOrders/{orderId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('inventory-logistics')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.supplierId is string
        && request.resource.data.supplierId.size() > 0
        && request.resource.data.status in ['pendente', 'aprovado', 'recebido', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /shipments/{shipmentId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('inventory-logistics')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['preparando', 'em_transito', 'entregue', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /warehouses/{warehouseId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('inventory-logistics')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ativo', 'inativo'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('inventory-logistics')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /productionPlans/{planId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('production')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.status in ['planejado', 'em_andamento', 'concluido', 'cancelado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /productionOrders/{orderId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('production')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.status in ['pendente', 'em_producao', 'concluida', 'cancelada'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /qualityChecks/{checkId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('production')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.item is string
        && request.resource.data.item.size() > 0
        && request.resource.data.status in ['pendente', 'aprovado', 'reprovado'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /maintenanceRequests/{requestId} {
      allow read: if belongsToCompany(resource.data.get('companyId', null));

      allow create: if isSignedIn()
        && belongsToCompany(request.resource.data.companyId)
        && hasModule('production')
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.equipmentName is string
        && request.resource.data.equipmentName.size() > 0
        && request.resource.data.status in ['agendada', 'em_andamento', 'concluida', 'cancelada'];

      allow update: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && request.resource.data.companyId == resource.data.get('companyId', null)
        && (
          isAdmin()
          || (resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId)
        );

      allow delete: if belongsToCompany(resource.data.get('companyId', null))
        && hasModule('production')
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

